# Which provider runs the chat loop.
#   unset            → auto: uses OPENAI_API_KEY when set, else Anthropic
#   openai | anthropic
JULIUS_PROVIDER=

# Chat model. Defaults:
#   anthropic → ANTHROPIC_DEFAULT_OPUS_MODEL else claude-opus-5-5
#   openai    → OPENAI_MODEL else gpt-5
JULIUS_MODEL=

# Small model for task titles (defaults similarly; e.g. claude-haiku-5-5 / gpt-5)
JULIUS_TITLE_MODEL=

# --- OpenAI --------------------------------------------------------
# Put your key here (this file is gitignored); never paste it in chat.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
# OPENAI_TITLE_MODEL=gpt-5

# --- Anthropic -----------------------------------------------------
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL are read from the environment
# by the SDK automatically when OPENAI is not chosen.